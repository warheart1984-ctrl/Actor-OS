# Copy to backend/.env and fill in the providers you actually use.
# Any provider left blank falls back to the deterministic mock connector.

PORT=4000

# Storage: sqlite (default, no setup) or postgres
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/lineage.sqlite
# DATABASE_URL=postgres://app:app@localhost:5432/appdb

OPENAI_API_KEY=
# OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=
# GEMINI_BASE_URL=

MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Local models through Ollama; set to true only when the daemon is running.
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# Lemonade — local AI server (LLM, TTS, image gen)
LEMONADE_ENABLED=true
LEMONADE_BASE_URL=http://127.0.0.1:13307/v1

# Optional override for Mandala crew pack (default: dist/mandala-crew after build,
# else repo .cursor/mandala-crew).
# MANDALA_CREW_ROOT=
